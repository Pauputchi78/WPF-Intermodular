<Window x:Class="Hotel_Pere_Maria.Views.InsertarUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Datos del Usuario" Height="650" Width="600"
        WindowStartupLocation="CenterScreen" Background="#F5F6F7">

    <Border Background="White" Margin="20" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.2"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" Text="Formulario de Usuario" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5">
                <TextBlock Text="Nombre:"/>
                <TextBox Padding="5" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5">
                <TextBlock Text="DNI:"/>
                <TextBox Padding="5" Text="{Binding DNI, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,5">
                <TextBlock Text="Email:"/>
                <TextBox Padding="5" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,5">
                <TextBlock Text="Ciudad:"/>
                <ComboBox Padding="5" SelectedIndex="{Binding CiudadIndex}">
                    <ComboBoxItem Content="Benidorm"/>
                    <ComboBoxItem Content="Alicante"/>
                    <ComboBoxItem Content="Valencia"/>
                    <ComboBoxItem Content="Madrid"/>
                    <ComboBoxItem Content="Otro"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Apellidos:"/>
                <TextBox Padding="5" Text="{Binding Apellido, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Rol:"/>
                <ComboBox x:Name="cbRol" Padding="5" SelectedIndex="{Binding RolIndex}">
                    <ComboBoxItem Content="client" IsSelected="True"/>
                    <ComboBoxItem Content="employee"/>
                    <ComboBoxItem x:Name="cbRolAdmin" Content="admin"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Contraseña:"/>
                <PasswordBox x:Name="txtPass" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,5">
                <TextBlock Text="Confirmar Contraseña:"/>
                <PasswordBox x:Name="txtPassConfirm" Padding="5"/>
            </StackPanel>

            <StackPanel Grid.Row="5" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,15">
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Fecha Nacimiento:"/>
                    <DatePicker Width="150" SelectedDate="{Binding FechaNacimiento}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Sexo:"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Hombre" Margin="5" IsChecked="{Binding EsHombre}"/>
                        <RadioButton Content="Mujer" Margin="5" IsChecked="{Binding EsMujer}"/>
                        <RadioButton Content="Otro" Margin="5" IsChecked="{Binding EsOtro}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Imagen de perfil -->
            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,10" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Imagen de perfil:" Margin="0,0,0,5"/>
                    <Button Content="📷 Seleccionar Imagen" Command="{Binding SeleccionarImagenCommand}"
                            Padding="8,5" Background="#3498DB" Foreground="White" Width="160"/>
                    <TextBlock Text="{Binding ImagenPath}" FontSize="10" Foreground="Gray" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                </StackPanel>
                <Image Source="{Binding ImagenPreview}" Width="80" Height="80" Margin="15,0,0,0"
                       Stretch="UniformToFill" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="7" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Command="{Binding CancelarCommand}" Width="100" Height="35" Background="Gray" Foreground="White" Margin="10,0"/>
                <Button Content="Guardar" Click="Click_Guardar" Width="100" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>