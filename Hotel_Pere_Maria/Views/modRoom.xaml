<Window x:Class="Hotel_Pere_Maria.Views.modRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hotel_Pere_Maria.Views"
        mc:Ignorable="d"
        Title="modRoom" Height="600" Width="800">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border>
            <TextBlock Text="Gestion de Habitación"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"
                       FontFamily="Segoe UI Black"/>
        </Border>

        <!-- Card formulario -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="15" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="1"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- room_id (normalmente NO editable) -->
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Room ID" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtRoomId" 
                             Height="30" 
                             IsReadOnly="{Binding IsRoomIdReadOnly}" 
                             Text="{Binding RoomId, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Tipo" FontSize="11" Margin="0,0,0,3"/>
                    <ComboBox x:Name="cmbType"
                                Height="30"
                                IsEditable="False"
                                SelectedValuePath="Content"
                                SelectedValue="{Binding Type}">
                        <ComboBoxItem Content="Individual"/>
                        <ComboBoxItem Content="Doble"/>
                        <ComboBoxItem Content="Suite"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <TextBlock Text="Precio / Noche" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtPrice" 
                             Height="30" 
                             Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                    <TextBlock Text="Max. Ocupación (automático)" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtMaxOcc" 
                             Height="30" 
                             Text="{Binding MaxOccupancy}"
                             VerticalContentAlignment="Center" 
                             IsReadOnly="True" 
                             Background="#F0F0F0"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                    <TextBlock Text="Valoración (rate)" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtRate" 
                             Height="30" 
                             Text="{Binding Rate, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Imagen (URL)" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtImage" 
                             Height="30" 
                             Text="{Binding Image, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="5">
                    <TextBlock Text="Descripción" FontSize="11" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtDescription"
                             Height="90"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>

                <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="5">
                    <CheckBox x:Name="chkAvailable" 
                              Content="Disponible" 
                              IsChecked="{Binding IsAvailable}"
                              Margin="0,10,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="6" Grid.ColumnSpan="2"
                           x:Name="txtMsg"
                           Foreground="#E74C3C"
                           FontSize="12"
                           Margin="5,10,5,0"/>
            </Grid>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Guardar"
                    Width="120"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#2ECC71"
                    Foreground="White"
                    FontWeight="Bold"
                    Command="{Binding SaveCommand}">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Content="Cancelar"
                    Width="120"
                    Height="35"
                    Background="#E74C3C"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="BtnCancelar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="5"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
